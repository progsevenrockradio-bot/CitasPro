# Entorno EXCLUSIVO de pruebas automatizadas (APP_ENV=testing).
# Laravel lo carga en lugar de .env cuando APP_ENV=testing.
# No contiene secretos reales: clave generada solo para tests, servicios simulados.
# Las variables definidas en el entorno del proceso (p. ej. DB_HOST del contenedor
# de pruebas) tienen prioridad sobre estos valores.
APP_NAME=CitasPro
APP_ENV=testing
APP_KEY=base64:dc5KNa+ITjDHA/2BCLg6EREfyhXpMyobgygS6IDYhYY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citaspro_test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BCRYPT_ROUNDS=4

# Sin envios reales
MAIL_MAILER=array
MAIL_FROM_ADDRESS=pruebas@ejemplo.local
MAIL_FROM_NAME=CitasPro-Tests
